%% chapmk.sty -- runtime records of incremental runs (design §6.4.2, Appendix B).
%% Loaded at the format split point of every incremental run (gensrc.run_main). Records and
%% hooks only, no logic. The version must equal the driver version (chapmk.__version__).
%% Bookkeeping uses macros only: every \count allocated here would enter the state vector.
\NeedsTeXFormat{LaTeX2e}[2025/11/01]
\ProvidesPackage{chapmk}[2026/11/03 v0.9.0 chapmk: runtime records]

\@ifundefined{chapmk@kernelcount}{%
  \PackageError{chapmk}{chapmk-ini.sty was not loaded before \string\documentclass}{}%
  \def\chapmk@kernelcount{0}}{}
% set by the driver before \usepackage{chapmk}: extra run-local register names ([state] ignore)
\providecommand\chapmk@denynames{}

%% ---------------------------------------------------------------- helpers
% current segment id: P (preamble after the split point: its files are global inputs of the
% build, a change is a cold build), G0 from \begin{document} on, then U<k>/G<k>
\def\chapmk@seg{P}%
\AddToHook{begindocument/before}{\gdef\chapmk@seg{G0}}
\def\chapmk@k{0}%     number of \include commands seen so far
\def\chapmk@wrapped{-1}% \include index whose checkpoint wrapper ran (excluded units)
\def\chapmk@inc#1{\xdef#1{\the\numexpr#1+1\relax}}
% \chapmk@idx{<csname>}: index of the \count register \<csname>, -1 otherwise (expandable;
% parses \meaning = "\count<n>")
\edef\chapmk@tmp{%
  \def\noexpand\chapmk@idx@##1\detokenize{count}##2\detokenize{count}##3\noexpand\@nil{%
    \noexpand\ifx\noexpand\relax##2\noexpand\relax -1\noexpand\else##2\noexpand\fi}}
\chapmk@tmp
\edef\chapmk@tmp{% the appended "countcount" must be literal (catcode 12) characters
  \def\noexpand\chapmk@idx##1{\noexpand\ifcsname##1\noexpand\endcsname
    \noexpand\expandafter\noexpand\expandafter\noexpand\expandafter\noexpand\chapmk@idx@
    \noexpand\expandafter\noexpand\meaning\noexpand\csname##1\noexpand\endcsname
    \detokenize{countcount}\noexpand\@nil
  \noexpand\else -1\noexpand\fi}}
\chapmk@tmp

%% ---------------------------------------------------------------- state vector (S4)
% members: kernel checkpoint counters (\chapmk@kidx, built at \begin{document}) and every
% register above \chapmk@kernelcount that is not run-local (\chapmk@deny@<n>).
\def\chapmk@kidx{}
\def\chapmk@setup@vector{%
  \def\@elt##1{\edef\chapmk@tmp{\chapmk@idx{c@##1}}%
    \ifnum\chapmk@tmp>-1 \ifnum\chapmk@tmp>\chapmk@kernelcount\else
      \xdef\chapmk@kidx{\chapmk@kidx\chapmk@tmp,}\fi\fi}%
  \cl@@ckpt
  \let\@elt\relax
  \edef\chapmk@tmp{Hy@abspage,BKM@id,calc@Acount,calc@Bcount,\chapmk@denynames}%
  \@for\chapmk@name:=\chapmk@tmp\do{\ifx\chapmk@name\@empty\else
    \edef\chapmk@tmp{\chapmk@idx{\chapmk@name}}%
    \ifnum\chapmk@tmp>-1 \expandafter\global\expandafter\let
      \csname chapmk@deny@\chapmk@tmp\endcsname\@empty\fi\fi}}
% \chapmk@vec: "n=v," for each vector register whose value differs from its reference value
% \<\chapmk@pfx>@<n> (0 if unset). Expandable; set \chapmk@pfx before writing.
\def\chapmk@pfx{chapmk@zero}
\def\chapmk@ref#1{\ifcsname\chapmk@pfx @#1\endcsname\csname\chapmk@pfx @#1\endcsname
  \else0\fi}
% (a space, not \relax, ends the number: \relax would remain in \write output);
% prefix "all" writes every register (complete vector)
\def\chapmk@all{all}
\def\chapmk@one#1{\ifx\chapmk@pfx\chapmk@all#1=\the\count#1,\else
  \ifnum\count#1=\chapmk@ref{#1} \else#1=\the\count#1,\fi\fi}
\def\chapmk@vec{\chapmk@cvec\chapmk@mvec}
\def\chapmk@cvec{\expandafter\chapmk@kvec\chapmk@kidx\@nil,\chapmk@rvec@start}
\def\chapmk@kvec#1,{\ifx\@nil#1\else\chapmk@one{#1}\expandafter\chapmk@kvec\fi}
\def\chapmk@rvec@start{%
  \expandafter\chapmk@rvec\expandafter{\the\numexpr\chapmk@kernelcount+1}}
\def\chapmk@rvec#1{\ifnum#1>\count10 \else
  \ifcsname chapmk@deny@#1\endcsname\else\chapmk@one{#1}\fi
  \expandafter\chapmk@rvec\expandafter{\the\numexpr#1+1\expandafter}\fi}
% store the current vector under prefix #1 (chapmk@b: baseline)
\def\chapmk@store#1{\def\chapmk@pfx{#1}%
  \@for\chapmk@tmp:=\chapmk@kidx\do{\ifx\chapmk@tmp\@empty\else
    \expandafter\xdef\csname#1@\chapmk@tmp\endcsname{\the\count\chapmk@tmp}\fi}%
  \xdef\chapmk@i{\the\numexpr\chapmk@kernelcount+1}%
  \chapmk@store@
  \chapmk@markmap\chapmk@mstore}
\def\chapmk@store@{\ifnum\chapmk@i>\count10 \else
  \expandafter\xdef\csname\chapmk@pfx @\chapmk@i\endcsname{\the\count\chapmk@i}%
  \chapmk@inc\chapmk@i\expandafter\chapmk@store@\fi}

%% ---------------------------------------------------------------- running-head marks
% The kernel's mark classes (\NewMarkClass; \markboth, \markright, \InsertMark) keep the
% marks of the last output page in g__mark_<region>_<top|first|last>_<class>_tl, as
% \__mark_value:nn{<id>}{<text>} (kernel >= 2025-06-01) or as the text itself (older). They belong to the state vector as pseudo registers
% \chapmk@markbase + <marks register of the class>: 0 if the last mark of the "page" region
% is empty, else a 28-bit digest of its text (ids are run-local). A unit records the texts
% of its page and column regions at its end (\chapmk@mk in the unit aux); an excluded unit
% restores those of the pseudo registers in its checkpoint, like its counters.
\def\chapmk@markbase{100000}
\ExplSyntaxOn
\cs_new:Npn \chapmk@markmap #1 { \seq_map_function:NN \g__mark_classes_seq #1 }
\ExplSyntaxOff
\def\chapmk@mid#1{\the\numexpr\chapmk@markbase+\csname c__mark_class_#1_mark\endcsname\relax}
\ifcsname __mark_value:nn\endcsname
  \def\chapmk@mtext#1#2#3{\detokenize{#3}}
  \def\chapmk@mtextof#1{%
    \expandafter\expandafter\expandafter\chapmk@mtext\csname g__mark_page_last_#1_tl\endcsname}
  % a stored mark from its text (restore)
  \def\chapmk@mvalue#1{\expandafter\noexpand\csname __mark_value:nn\endcsname{0}{\unexpanded{#1}}}
\else
  \def\chapmk@mtextof#1{%
    \detokenize\expandafter\expandafter\expandafter{\csname g__mark_page_last_#1_tl\endcsname}}
  \def\chapmk@mvalue#1{\unexpanded{#1}}
\fi
\def\chapmk@seven#1#2#3#4#5#6#7#8\@nil{#1#2#3#4#5#6#7}
% the digest is taken of the text as an aux file gives it back (written and re-read: e.g.
% the robust "\MakeUppercase " becomes \MakeUppercase), so a restored mark has the digest of
% the original; \chapmk@mprep computes the digests before a vector is written
\def\chapmk@mprep{\chapmk@markmap\chapmk@mprep@}
\def\chapmk@mprep@#1{\begingroup
  \edef\chapmk@tmp{\chapmk@mtextof{#1}}%
  \ifx\chapmk@tmp\@empty\global\let\chapmk@tmpa\@empty\else
    \makeatletter\endlinechar\m@ne\everyeof{}%
    \expandafter\scantokens\expandafter{\expandafter\gdef\expandafter\chapmk@tmpa
      \expandafter{\chapmk@tmp}}\fi
  \endgroup
  \expandafter\xdef\csname chapmk@md@#1\endcsname{\ifx\chapmk@tmpa\@empty0\else
    \number"\expandafter\chapmk@seven\pdfmdfivesum{\detokenize\expandafter{\chapmk@tmpa}}%
    \@nil\fi}}
\def\chapmk@mdigest#1{\csname chapmk@md@#1\endcsname}
% vector part (expandable, like \chapmk@one)
\def\chapmk@mvec{\chapmk@markmap\chapmk@mone}
\def\chapmk@mone#1{\expandafter\chapmk@mone@\expandafter{\the\numexpr\chapmk@mid{#1}}{#1}}
\def\chapmk@mone@#1#2{\ifx\chapmk@pfx\chapmk@all#1=\chapmk@mdigest{#2},\else
  \ifnum\chapmk@mdigest{#2}=\chapmk@ref{#1} \else#1=\chapmk@mdigest{#2},\fi\fi}
\def\chapmk@mstore#1{%
  \expandafter\xdef\csname\chapmk@pfx @\chapmk@mid{#1}\endcsname{\chapmk@mdigest{#1}}}
% segment start: snapshot of the last marks; at its end a changed one is an absolute
% assignment of the segment (prediction: the exit does not depend on the entry)
\def\chapmk@msnap#1{\expandafter\global\expandafter\let\csname chapmk@msnap@#1\expandafter
  \endcsname\csname g__mark_page_last_#1_tl\endcsname}
\def\chapmk@mabs#1{\expandafter\ifx\csname chapmk@msnap@#1\expandafter\endcsname
  \csname g__mark_page_last_#1_tl\endcsname\else
  \edef\chapmk@absidx{\chapmk@absidx\chapmk@mid{#1},}\fi}
% unit end: "\chapmk@mk{<id>}{<class>}{<region_slot>}{<text>}" for the page and column regions
\def\chapmk@mkrec#1{\@for\chapmk@slot:=page_top,page_first,page_last,column_top,%
  column_first,column_last\do{\chapmk@mkrec@{#1}}}
\ifcsname __mark_value:nn\endcsname
  \def\chapmk@mkrec@#1{\expandafter\expandafter\expandafter\chapmk@mkrec@@
    \csname g__mark_\chapmk@slot _#1_tl\endcsname{#1}}
\else  % the stored mark is the text: pass it as the third argument
  \def\chapmk@mkrec@#1{%
    \expandafter\let\expandafter\chapmk@tmpm\csname g__mark_\chapmk@slot _#1_tl\endcsname
    \expandafter\chapmk@mkrec@@\expandafter\relax\expandafter{\expandafter}\expandafter
      {\chapmk@tmpm}{#1}}
\fi
\def\chapmk@mkrec@@#1#2#3#4{\immediate\write\@partaux{\string\chapmk@mk
  {\chapmk@mid{#4}}{#4}{\chapmk@slot}{\unexpanded{#3}}}}
% read from the unit aux before its \@setckpt (collected per unit, see \@setckpt below)
\def\chapmk@lastmk{}
\long\def\chapmk@mk#1#2#3#4{\xdef\chapmk@lastmk{\unexpanded\expandafter{\chapmk@lastmk}%
  \noexpand\chapmk@mset{#1}{#2}{#3}{\unexpanded{#4}}}}
% restore (excluded unit): only the pseudo registers listed in the checkpoint
\long\def\chapmk@mset#1#2#3#4{\ifcsname chapmk@mon@#1\endcsname
  \expandafter\xdef\csname g__mark_#3_#2_tl\endcsname{\chapmk@mvalue{#4}}\fi}
% primitive marks (\mark, \marks outside the kernel's classes) cannot be restored: record
% their use ("K primitive"; the driver falls back to full mode)
\def\chapmk@mclass#1{\expandafter\let\csname chapmk@mreg@\number
  \csname c__mark_class_#1_mark\endcsname\endcsname\@empty
  \immediate\write\chapmk@rec{K \chapmk@mid{#1} #1}}
\def\chapmk@primitive{\begingroup\count@\z@
  \loop\ifnum\count@>\count256 \else
    \ifcsname chapmk@mreg@\the\count@\endcsname\else
      \if\relax\detokenize\expandafter{\botmarks\count@}\relax\else
        \immediate\write\chapmk@rec{K primitive \the\count@}\count@\count256 \fi\fi
    \advance\count@\@ne\repeat\endgroup}

%% ---------------------------------------------------------------- records
\newwrite\chapmk@rec
\immediate\openout\chapmk@rec=\jobname.frec
% elapsed TeX time (phases of the report): "T <point> <scaled seconds>" at package load, \begin{document},
% each segment start and \end{document}
\def\chapmk@time#1{\ifdefined\pdfelapsedtime
  \immediate\write\chapmk@rec{T #1 \the\pdfelapsedtime}\fi}
\chapmk@time{load}
% time inside pgf pictures (tikzpicture, \tikz, pgfplots: all use \pgfpicture)
\AtBeginDocument{\ifdefined\pgfpicture
  \AddToHook{cmd/pgfpicture/before}{\chapmk@time{picture+}}%
  \AddToHook{cmd/endpgfpicture/after}{\chapmk@time{picture-}}\fi}
\def\chapmk@main#1{\immediate\write\@mainaux{#1}}
% segment start marker in the log (§6.13: the driver composes one log from the runs' slices;
% \include's \clearpage before include/before and include/after puts each segment's pages
% and messages between its markers)
\def\chapmk@logmark#1{\wlog{chapmk-segment: #1}}
\def\chapmk@entry@rec{\chapmk@asnap\chapmk@logmark{\chapmk@seg}\chapmk@time{\chapmk@seg}\chapmk@markmap\chapmk@msnap\chapmk@mprep
  \def\chapmk@pfx{chapmk@b}%
  \chapmk@main{\string\chapmk@entry{\chapmk@seg}{\chapmk@vec}}}
\def\chapmk@gexit@rec{\chapmk@mprep\def\chapmk@pfx{chapmk@b}%
  \chapmk@main{\string\chapmk@gexit{\chapmk@seg}{\chapmk@vec}}}
% segment markers in the nomenclature and index streams (delayed, like their own writes;
% S2b): \makenomenclature's .nlo, \makeindex's .idx
\def\chapmk@mark{\chapmk@mark@in\@nomenclaturefile\chapmk@mark@in\@indexfile}
\def\chapmk@mark@in#1{\ifdefined#1%
  \edef\chapmk@tmp{\noexpand\protected@write\noexpand#1{}%
    {\@percentchar chapmk-seg \chapmk@seg}}\chapmk@tmp\fi}
% absolute assignments of the current segment (counter names), for prediction (§6.9.3)
\def\chapmk@absnames{}
\def\chapmk@abs@add#1{\xdef\chapmk@absnames{\chapmk@absnames#1,}}
\def\chapmk@abs@rec#1{% #1: write stream
  \def\chapmk@absidx{}%
  \@for\chapmk@tmp:=\chapmk@absnames\do{\ifx\chapmk@tmp\@empty\else
    \edef\chapmk@absidx{\chapmk@absidx\chapmk@idx{c@\chapmk@tmp},}\fi}%
  \chapmk@markmap\chapmk@mabs
  \immediate\write#1{\string\chapmk@abs{\chapmk@seg}{\chapmk@absidx}}%
  \gdef\chapmk@absnames{}}
% (\protected: never expanded in \edef/\write contexts)
\AtBeginDocument{\let\chapmk@orig@setcounter\setcounter
  \protected\def\setcounter#1{\chapmk@abs@add{#1}\chapmk@orig@setcounter{#1}}%
  \let\chapmk@orig@stpelt\@stpelt
  \protected\def\@stpelt#1{\chapmk@abs@add{#1}\chapmk@orig@stpelt{#1}}%
  \let\chapmk@orig@pagenumbering\pagenumbering
  \protected\def\pagenumbering{\chapmk@abs@add{page}\chapmk@orig@pagenumbering}}
% "G <unit> pagenumbering|pagestyle": the unit ends with another page numbering style
% (\thepage) or page style (head and foot macros) than it started with, also through a
% class macro the lint does not see (tcdthesis switches both in \@chapter for chapter 1):
% state no checkpoint carries; the driver makes the unit global. Compared at the unit's
% start and end (a temporary switch, e.g. KOMA's chapter page style, is no change).
\def\chapmk@gsave{\global\let\chapmk@tp\thepage\global\let\chapmk@oh\@oddhead
  \global\let\chapmk@eh\@evenhead\global\let\chapmk@of\@oddfoot
  \global\let\chapmk@ef\@evenfoot}
\def\chapmk@gcheck{%
  \ifx\chapmk@tp\thepage\else\chapmk@grec{pagenumbering}\fi
  \ifx\chapmk@oh\@oddhead\ifx\chapmk@eh\@evenhead\ifx\chapmk@of\@oddfoot
    \ifx\chapmk@ef\@evenfoot\else\chapmk@grec{pagestyle}\fi\else\chapmk@grec{pagestyle}\fi
    \else\chapmk@grec{pagestyle}\fi\else\chapmk@grec{pagestyle}\fi}
\def\chapmk@grec#1{\immediate\write\chapmk@rec{G \chapmk@seg\space#1}}
% anchors read across segments (S19). "R <seg> <command> <line>": \addcontentsline (with
% hyperref: its link target) or \label (its number and target) used the anchor the segment
% started with, i.e. one of an earlier segment, e.g. KOMA's listof=totoc after the last
% \include (KOMA's \chapter* sets no anchor). Old means: the value is the one at the segment's
% start (a float's local anchor reverts to it) and the segment created no anchor of that name
% (\hyper@anchorstart) or no number of that counter (\refstepcounter): a name created again,
% e.g. sections renumbered after KOMA's \chapter*, is the segment's own. "H <seg>": the
% segment ends with an anchor or number of its own. The driver makes the unit global that
% set the anchor a later segment uses.
\def\chapmk@asnap{\global\let\chapmk@ahref\@currentHref
  \global\let\chapmk@alabel\@currentlabel\global\let\chapmk@acounter\@currentcounter}
% names created in the current segment
\def\chapmk@anew#1{\expandafter\gdef\csname chapmk@an@\chapmk@seg @#1\endcsname{}}
\def\chapmk@lnew{\expandafter\gdef\csname chapmk@ln@\chapmk@seg @\@currentcounter
  @\detokenize\expandafter{\@currentlabel}\endcsname{}}
\AddToHook{cmd/refstepcounter/after}{\chapmk@lnew}
\def\chapmk@ahyper{\AddToHookWithArguments{cmd/hyper@anchorstart/before}{\chapmk@anew{##1}}%
  \AddToHook{cmd/addcontentsline/before}{\chapmk@hrefold{\chapmk@aread{addcontentsline}}{}}}
\AddToHook{begindocument/before}{\@ifpackageloaded{hyperref}{\chapmk@ahyper}{}}
% \chapmk@hrefold{<true>}{<false>}: \@currentHref is old; \chapmk@labelold: \@currentlabel
\def\chapmk@hrefold{\let\chapmk@tmpf\@secondoftwo
  \ifx\chapmk@ahref\@currentHref
    \ifcsname chapmk@an@\chapmk@seg @\@currentHref\endcsname\else
      \let\chapmk@tmpf\@firstoftwo\fi\fi
  \chapmk@tmpf}
\def\chapmk@labelold{\let\chapmk@tmpf\@secondoftwo
  \ifx\chapmk@alabel\@currentlabel\ifx\chapmk@acounter\@currentcounter
    \ifcsname chapmk@ln@\chapmk@seg @\@currentcounter
      @\detokenize\expandafter{\@currentlabel}\endcsname\else
      \let\chapmk@tmpf\@firstoftwo\fi\fi\fi
  \chapmk@tmpf}
\AddToHook{cmd/label/before}{%
  \chapmk@hrefold{\chapmk@aread{label}}{\chapmk@labelold{\chapmk@aread{label}}{}}}
\def\chapmk@Gzero{G0}% G0: no earlier segment
\def\chapmk@aread#1{\ifx\chapmk@seg\chapmk@Gzero\else
  \immediate\write\chapmk@rec{R \chapmk@seg\space#1 \the\inputlineno}\fi}
\def\chapmk@aend{\chapmk@hrefold{\chapmk@labelold{}{\chapmk@arecH}}{\chapmk@arecH}}
\def\chapmk@arecH{\immediate\write\chapmk@rec{H \chapmk@seg}}

% segment transitions
\def\chapmk@glue@end{\chapmk@aend\chapmk@gexit@rec\chapmk@abs@rec\@mainaux}
\def\chapmk@unit@begin#1{% #1: include argument as known (may be empty)
  \chapmk@inc\chapmk@k
  \chapmk@glue@end
  \xdef\chapmk@seg{U\chapmk@k}%
  \chapmk@main{\string\chapmk@unit{\chapmk@seg}{#1}}%
  \chapmk@entry@rec\chapmk@mark}
\def\chapmk@glue@begin{%
  \xdef\chapmk@seg{G\chapmk@k}\chapmk@entry@rec\chapmk@mark\gdef\chapmk@absnames{}}

% included unit (S3: after the first \clearpage, unit aux open)
% "O <seg> 0|1": the unit starts under twoside+openright (local settings such as KOMA's
% open=any in a group around the \include count; odd-start prediction)
% 1 if \if@<name> is true (expandable). \ifcsname first: \csname would define an undefined
% \if@<name> as \relax; \iftrue must not appear in skipped text (it counts as a conditional)
\def\chapmk@iftrue#1{\ifcsname if@#1\endcsname\expandafter\@firstoftwo\else
  \expandafter\@secondoftwo\fi{\chapmk@iftrue@{#1}}{0}}
\def\chapmk@iftrue@#1{\expandafter\ifx\csname if@#1\endcsname\iftrue1\else0\fi}
\def\chapmk@open@rec{\immediate\write\chapmk@rec{O \chapmk@seg\space
  \ifnum\chapmk@iftrue{twoside}\chapmk@iftrue{openright}=11 1\else0\fi}}
\AddToHook{include/before}{%
  \chapmk@unit@begin{\CurrentFilePath/\CurrentFile}\gdef\chapmk@absnames{}\chapmk@open@rec
  \chapmk@gsave
  \immediate\write\@partaux{\string\chapmk@ustart{\chapmk@seg}}}
% unit end after the final \clearpage, unit aux still open (S3). The checkpoint is the
% complete vector: the restore of an excluded unit must also undo changes made by the
% exclusion itself (e.g. calc's \setcounter scratch register during the kernel restore).
\AddToHook{include/after}{%
  \let\chapmk@pfx\chapmk@all
  \chapmk@gcheck\chapmk@aend
  \chapmk@markmap\chapmk@mkrec
  \chapmk@primitive
  \chapmk@mprep
  \immediate\write\@partaux{\string\chapmk@ckpt{\chapmk@seg}{\chapmk@vec}}%
  \chapmk@abs@rec\@partaux
  \chapmk@glue@begin}

% excluded unit: the kernel restores \cp@<unit> before include/excluded (S3), so the entry is
% recorded by wrapping \@setckpt (read from the unit aux); chapmk's restore follows the
% kernel's. The \chapmk@ckpt record read just before \@setckpt belongs to the same unit.
\def\chapmk@lastckpt{}
\def\chapmk@ckpt#1#2{\gdef\chapmk@lastckpt{#2}}
\let\chapmk@orig@setckpt\@setckpt
\def\@setckpt#1#2{%
  \expandafter\global\expandafter\let\csname chapmk@ck@#1\endcsname\chapmk@lastckpt
  \global\let\chapmk@lastckpt\@empty
  \expandafter\global\expandafter\let\csname chapmk@mk@#1\endcsname\chapmk@lastmk
  \global\let\chapmk@lastmk\@empty
  \chapmk@orig@setckpt{#1}{\chapmk@excluded@begin{#1}#2\chapmk@restore{#1}}}
\def\chapmk@excluded@begin#1{\chapmk@unit@begin{#1}\chapmk@firstpage\xdef\chapmk@wrapped{\chapmk@k}}
% S15: the nodes on the main vertical list before the first page (\begin{document} material
% such as hyperref's Doc-Start destination, the S13 nodes) go to the first page TeX ships. In
% a full build that is the document's first page; when the document starts with an \include
% this run excludes, it would be a later page. Before the first excluded unit's checkpoint, if
% nothing was shipped yet, they are shipped on an extra page, which the merges skip (no page
% record), so their effects (colour stack) still hold for the run's pages. \RawShipout: no
% shipout/before hooks (no page record), but LaTeX's shipout/firstpage material (hyperref) goes
% onto this page, and the shipout counter counts it (page indices stay right). Local output
% routine as \chapmk@capturemvl (S13): the empty \hbox and its \topskip glue are removed.
% After the unit's entry record, as in a run that compiles the unit (its first page ships
% after include/before): deferred writes of the glue before it (\addtocontents, babel's
% language records) then reach the aux and list files after that record, not inside the
% unit's list-file section or main-aux slice.
\def\chapmk@firstpage{\ifvmode\ifnum\ReadonlyShipoutCounter=0 \ifnum\chapmk@pics=0
  \edef\chapmk@pd{\the\prevdepth}\edef\chapmk@op{\the\outputpenalty}%
  \begingroup
    \output{\RawShipout\vbox{\unvbox255 \setbox0\lastbox\unskip}}%
    \hbox{}\penalty-10000
  \endgroup
  \deadcycles=0 \global\outputpenalty=\chapmk@op\relax \prevdepth=\chapmk@pd\relax\fi\fi\fi}
\def\chapmk@restore#1{% assign the stored post-kernel registers (S4) and marks
  \edef\chapmk@tmp{\csname chapmk@ck@#1\endcsname}%
  \@for\chapmk@tmp:=\chapmk@tmp\do{\ifx\chapmk@tmp\@empty\else
    \expandafter\chapmk@assign\chapmk@tmp\@nil\fi}%
  \csname chapmk@mk@#1\endcsname
  \chapmk@markmap\chapmk@moff}
\def\chapmk@moff#1{\expandafter\global\expandafter\let\csname chapmk@mon@\chapmk@mid{#1}%
  \endcsname\@undefined}
\def\chapmk@assign#1=#2\@nil{%
  \ifnum#1<\chapmk@markbase\relax\else
    \expandafter\global\expandafter\let\csname chapmk@mon@#1\endcsname\@empty\fi
  \ifnum#1<\chapmk@markbase\relax\ifnum#1>\chapmk@kernelcount\relax
    \ifcsname chapmk@deny@#1\endcsname\else\global\count#1=#2\relax\fi\fi\fi}
\AddToHook{include/excluded}{%
  \ifnum\chapmk@wrapped=\chapmk@k\else % never compiled: no checkpoint, no entry
    \chapmk@inc\chapmk@k\chapmk@glue@end
    \xdef\chapmk@seg{U\chapmk@k}\chapmk@main{\string\chapmk@unit{\chapmk@seg}{}}\fi
  \chapmk@glue@begin}

% page map and file attribution (\jobname.frec). The page label is \thepage as plain text
% (expl3's text purification, like hyperref's page labels): babel-spanish's roman numerals
% (\protect\es@scroman{i}) expanded in the \write gave "Unbalanced write command".
\ExplSyntaxOn
\cs_new:Npn \chapmk@pagelabel { \text_purify:n { \thepage } }
\ExplSyntaxOff
\AddToHook{shipout/before}{\edef\chapmk@tmp{\chapmk@pagelabel}%
  \immediate\write\chapmk@rec{P \the\numexpr\ReadonlyShipoutCounter+\chapmk@pics\relax\space%
    \chapmk@seg\space
    \the\c@page\space\detokenize\expandafter{\chapmk@tmp}}}
\AddToHook{file/before}{\immediate\write\chapmk@rec{F \chapmk@seg\space
  \CurrentFilePathUsed/\CurrentFileUsed}}
\AtBeginDocument{\ifdefined\Gin@setfile
  \let\chapmk@orig@Gin@setfile\Gin@setfile
  \def\Gin@setfile#1#2#3{\immediate\write\chapmk@rec{F \chapmk@seg\space#3}%
    \chapmk@orig@Gin@setfile{#1}{#2}{#3}}\fi}

% counters: register and reset list (\cl@<name>) of each checkpointed counter, as
% "name=<register>:child/child/;" (entry differences in counters that a unit's leading
% numbered heading resets are irrelevant)
\def\chapmk@counters@rec{\begingroup
  \def\@elt##1{##1,}\edef\chapmk@names{\cl@@ckpt}%
  \def\@elt##1{##1/}\def\chapmk@tmp{}%
  \@for\chapmk@name:=\chapmk@names\do{\ifx\chapmk@name\@empty\else
    \edef\chapmk@tmp{\chapmk@tmp\chapmk@name=\chapmk@idx{c@\chapmk@name}:%
      \ifcsname cl@\chapmk@name\endcsname\csname cl@\chapmk@name\endcsname\fi;}\fi}%
  \chapmk@main{\string\chapmk@counters{\chapmk@tmp}}%
  \endgroup}

% page layout flags for prediction (chapters start on odd pages in twoside+openright)
\def\chapmk@layout@rec{%
  \chapmk@main{\string\chapmk@layout{twoside=\chapmk@iftrue{twoside},%
    openright=\chapmk@iftrue{openright}}}}

% list-file markers: \chapmk@lmark{U<k>} before a unit's list contributions (first
% statement of its aux) and \chapmk@lmark{/<seg>} after each entry record, written while
% the aux files are read at \end{document}; the driver splices list files by them
\providecommand\chapmk@listexts{toc,lof,lot,loalg,lol,tdo}
% "L <seg> <ext>": a list file read by \@starttoc (lists with other extensions: algorithm's
% .loa, tocbasic's \DeclareNewTOC); the driver then copies, stores and splices them too, and
% the segment reads that list (also through a class macro the source scan does not see)
\AddToHookWithArguments{cmd/@starttoc/before}{\immediate\write\chapmk@rec{L \chapmk@seg\space#1}}
\def\chapmk@lmark#1{}
% a list typeset inside a unit (\tableofcontents in a front-matter unit, a class's preface
% command) is not opened by a run that excludes that unit: LaTeX would drop every unit's
% entries for it while it reads the aux files. Before that, each of the document's list files
% (one the canonical state has) that no \@starttoc opened is opened, as \@starttoc would.
\def\chapmk@openlist#1{\ifcsname tf@#1\endcsname\else\IfFileExists{\jobname.#1}{%
  \expandafter\newwrite\csname tf@#1\endcsname
  \immediate\openout\csname tf@#1\endcsname\jobname.#1\relax}{}\fi}
\AddToHook{enddocument/afterlastpage}{\if@filesw\@for\chapmk@ext:=\chapmk@listexts\do{%
  \expandafter\chapmk@openlist\expandafter{\chapmk@ext}}\fi}
\def\chapmk@listmarks#1{\@for\chapmk@ext:=\chapmk@listexts\do{%
  \@writefile{\chapmk@ext}{\chapmk@lmark{#1}}}}
\def\chapmk@ustart#1{\chapmk@listmarks{#1}}

% eqparbox tags used per segment: "Q <segment> <tag>" for every use
\def\chapmk@eqp#1{\immediate\write\chapmk@rec{Q \chapmk@seg\space#1}}% expandable (eqparbox uses it in \csname)
\def\chapmk@eqp@hooks{%
  \AddToHookWithArguments{cmd/eqp@compute@width/before}{\chapmk@eqp{##1}}%
  \AddToHookWithArguments{cmd/eqp@set@min@width/before}{\chapmk@eqp{##1}}}
\AtBeginDocument{\ifdefined\eqp@compute@width\chapmk@eqp@hooks\fi}

% aux handlers (aux files are read at \begin and \end{document})
\def\chapmk@counters#1{}
\def\chapmk@layout#1{}
\def\chapmk@base#1{}
\def\chapmk@entry#1#2{\chapmk@listmarks{/#1}}
\def\chapmk@gexit#1#2{}
\def\chapmk@abs#1#2{}
\def\chapmk@unit#1#2{}
\def\chapmk@bkmlevels#1{}

% baseline at the end of the \begin{document} hooks
\AddToHook{begindocument/end}{%
  \chapmk@main{\string\providecommand\string\chapmk@base[1]{}%
    \string\providecommand\string\chapmk@entry[2]{}\string\providecommand\string\chapmk@gexit[2]{}%
    \string\providecommand\string\chapmk@abs[2]{}\string\providecommand\string\chapmk@unit[2]{}%
    \string\providecommand\string\chapmk@ckpt[2]{}\string\providecommand\string\chapmk@bkmlevels[1]{}%
    \string\providecommand\string\chapmk@counters[1]{}\string\providecommand\string\chapmk@layout[1]{}%
    \string\providecommand\string\chapmk@ustart[1]{}\string\providecommand\string\chapmk@mk[4]{}}%
  \chapmk@time{begin}%
  \chapmk@setup@vector
  \chapmk@markmap\chapmk@mclass
  \chapmk@mprep
  \chapmk@counters@rec
  \chapmk@layout@rec
  \chapmk@store{chapmk@b}%
  \def\chapmk@pfx{chapmk@zero}%
  \chapmk@main{\string\chapmk@base{\chapmk@vec}}%
  \chapmk@entry@rec\chapmk@mark
  \gdef\chapmk@absnames{}}

% end of the last segment's pages: the rest of the log (aux check, rerun warnings, output
% summary) is the tail of the composed log
\AddToHook{enddocument/afterlastpage}{\chapmk@logmark{end}}

% end of the last glue segment; bookmark levels (S6: \BKM@<id> = {parent}{level}{children})
\def\chapmk@lvl#1#2#3{#2}
\AddToHook{enddocument}{%
  \chapmk@time{end}%
  \chapmk@primitive
  \chapmk@glue@end
  \ifdefined\BKM@id
    \def\chapmk@tmp{}\gdef\chapmk@i{1}%
    \loop\ifnum\chapmk@i>\BKM@id\else
      \edef\chapmk@tmp{\chapmk@tmp\chapmk@i=%
        \expandafter\expandafter\expandafter\chapmk@lvl\csname BKM@\chapmk@i\endcsname,}%
      \chapmk@inc\chapmk@i\repeat
    \chapmk@main{\string\chapmk@bkmlevels{\chapmk@tmp}}%
  \fi}

% picture cache (§6.17; chapmk-ini.sty): records carry the segment, the key's state part is
% the state vector (run-local registers excluded, so keys do not depend on the selection)
\def\chapmk@picseg{\chapmk@seg}
\def\chapmk@picstate@setup{\let\chapmk@pfx\chapmk@all}
\def\chapmk@picstate{\chapmk@cvec}
% S13: the nodes the format part left on the main vertical list and its \prevdepth
% (chapmk-ini.sty)
\ifdefined\chapmk@mvlbox\ifvoid\chapmk@mvlbox\else\unvbox\chapmk@mvlbox\fi\fi
\ifdefined\chapmk@mvlpd\ifvmode\prevdepth=\chapmk@mvlpd\relax\fi\fi
% the deferral table (§6.3.3)
\chapmk@deferred
% S13: the primitives wrapped in the format part (chapmk-ini.sty) after their replay
\ifdefined\chapmk@pdfunwrapall\chapmk@pdfunwrapall\fi

\endinput
