%% fastinc-ini.sty -- loaded before \documentclass in format builds and in full-mode and
%% reference builds (PLAN §6.4.1). Records and hooks only, no logic.
%% The version must equal the driver version (fastinc.__version__).
\NeedsTeXFormat{LaTeX2e}[2023/06/01]
\ProvidesPackage{fastinc-ini}[2026/10/31 v0.1.0 fastinc: format and reference-build hooks]

% Kernel register boundary (S4): \count registers with a higher index are allocated by the
% class, packages or the document; only those belong to the state vector.
\xdef\fastinc@kernelcount{\the\count10}

% Externalize redirection (§6.4.3, §6.17, S12). The user's \tikzexternalize keeps its
% effect (every picture is externalized unless disabled); only how a picture becomes a figure
% changes: no system call, no shell escape. A figure is looked up by its key (md5 of the
% picture code and the state it is typeset in) in \fastinc@picdir. A missing figure is
% typeset inline, with the \count registers restored afterwards as if the picture had been
% skipped (externalize semantics), and a copy of its box is shipped as an extra page
% (primitive \shipout, no LaTeX hooks). Records in the log (one line each):
%   fastinc-picture: x <key> <0-based PDF page> <depth> <segment>   exported
%   fastinc-picture: u <key> <segment>                              figure used
%   fastinc-picture: s <key> <picture code>                         code of an exported one
% Driver parameters (fastinc-pics.tex, read at \begin{document}): \fastinc@picdir (relative
% to the working directory, with a trailing slash; empty: no cache, pictures inline),
% \fastinc@picstamp, \fastinc@picrefs@<segment>.
\def\fastinc@picdir{}
\def\fastinc@picstamp{}
\def\fastinc@pics{0}% extra pages shipped so far (fastinc.sty adds it to page indices)
\def\fastinc@picseg{-}% segment of the records (fastinc.sty: the current segment)
\def\fastinc@picdepth{0}% \pgfpicture nesting
\def\fastinc@pictarget{0}
\def\fastinc@picexport{}% key of the picture being typeset for export
\def\fastinc@picstate@setup{}
% state part of the key: all \count registers (fastinc.sty: the state vector, without the
% run-local registers)
\def\fastinc@allcounts#1{\ifnum#1>\count10 \else#1=\the\count#1,%
  \expandafter\fastinc@allcounts\expandafter{\the\numexpr#1+1\expandafter}\fi}
\def\fastinc@picstate{\fastinc@allcounts{0}}
\def\fastinc@picrec#1{\immediate\write-1{fastinc-picture: #1}}
\newbox\fastinc@picbox
\ExplSyntaxOn \cs_new_eq:NN \fastinc@shipout \tex_shipout:D \ExplSyntaxOff
% registers before an inline picture; restored after it (not the allocation registers 10-19)
\def\fastinc@snap{\xdef\fastinc@snapped{\fastinc@allcounts{0}}}
\def\fastinc@unsnap{\expandafter\fastinc@unsnap@\fastinc@snapped-1=0,}
\def\fastinc@unsnap@#1=#2,{\ifnum#1<0 \else
  \ifnum#1>9 \ifnum#1<20 \else\ifnum\count#1=#2 \else\global\count#1=#2\relax\fi\fi
  \else\ifnum\count#1=#2 \else\global\count#1=#2\relax\fi\fi
  \expandafter\fastinc@unsnap@\fi}
\def\fastinc@picrefs{\ifcsname fastinc@picrefs@\fastinc@picseg\endcsname
  \csname fastinc@picrefs@\fastinc@picseg\endcsname\fi}
% the counter state enters the key only if the code shows counters (\the..., \arabic, ...;
% not \theta): otherwise shifted page numbers would invalidate every later figure
\edef\fastinc@countersre{\detokenize{\\}(the([^t]|t[^a]|ta[^ ])|arabic|roman|Roman|alph|Alph|%
  fnsymbol|value|number|romannumeral|c@)}
% replaces TikZ external's system-call handler; #1: the picture body
\long\def\fastinc@picture#1{%
  \fastinc@picstate@setup
  \edef\fastinc@pickey{\pdfmdfivesum{\detokenize{#1}|\fastinc@picstamp|\fastinc@picrefs|%
    \ifnum\pdfmatch{\fastinc@countersre}{\detokenize{#1}}=1 \fastinc@picstate\fi|\the\linewidth|\the\hsize|\fontname\font|\f@size|\the\baselineskip|%
    \ifdefined\current@color\current@color\fi}}%
  \ifx\fastinc@picdir\@empty\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi
  {\tikzexternaldisable\tikzpicture#1\end{tikzpicture}}% no cache: plain inline picture
  {\IfFileExists{\fastinc@picdir\fastinc@pickey.pdf}{%
     \fastinc@picrec{u \fastinc@pickey\space\fastinc@picseg}%
     \expandafter\pgfincludeexternalgraphics\expandafter{\fastinc@picdir\fastinc@pickey}%
     \tikzexternal@closeenvironments}{\fastinc@inline{#1}}}}
\long\def\fastinc@inline#1{%
  \fastinc@picrec{s \fastinc@pickey\space\detokenize{#1}}%
  \fastinc@snap
  \xdef\fastinc@picexport{\fastinc@pickey}%
  \xdef\fastinc@pictarget{\the\numexpr\fastinc@picdepth+1}%
  \tikzexternaldisable
  \tikzpicture#1\end{tikzpicture}%
  \global\let\fastinc@picexport\@empty
  \fastinc@unsnap}
% the final box of the exported picture: shipped as an extra page, then typeset
\def\fastinc@typesetpicturebox#1{%
  \ifx\fastinc@picexport\@empty\fastinc@orig@typesetpicturebox#1\else
  \ifnum\fastinc@picdepth=\fastinc@pictarget\relax
    \setbox\fastinc@picbox\hbox{\fastinc@orig@typesetpicturebox#1}%
    \fastinc@picship
    \unhbox\fastinc@picbox\spacefactor\@m
  \else\fastinc@orig@typesetpicturebox#1\fi\fi}
\def\fastinc@picship{%
  \ifdim\wd\fastinc@picbox>\z@ \ifdim\dimexpr\ht\fastinc@picbox+\dp\fastinc@picbox>\z@
    \begingroup
      \pdfpagewidth=\wd\fastinc@picbox
      \pdfpageheight=\dimexpr\ht\fastinc@picbox+\dp\fastinc@picbox\relax
      \pdfhorigin=\z@ \pdfvorigin=\z@
      \setbox\z@\vbox{\hbox{\copy\fastinc@picbox}}%
      \fastinc@shipout\box\z@
    \endgroup
    \fastinc@picrec{x \fastinc@picexport\space
      \the\numexpr\ReadonlyShipoutCounter+\fastinc@pics\relax\space
      \the\dp\fastinc@picbox\space\fastinc@picseg}%
    \xdef\fastinc@pics{\the\numexpr\fastinc@pics+1}%
  \fi\fi
  \global\let\fastinc@picexport\@empty}
\def\fastinc@redirect@externalize{%
  \let\fastinc@orig@externalize\tikzexternalize
  \def\tikzexternalize{\@ifnextchar[\fastinc@externalize{\fastinc@externalize[]}}%
  \let\tikzexternal@externalizefig@systemcall@@\fastinc@picture
  \let\fastinc@orig@typesetpicturebox\pgfsys@typesetpicturebox
  \let\pgfsys@typesetpicturebox\fastinc@typesetpicturebox
  \AddToHook{cmd/pgfpicture/before}{\xdef\fastinc@picdepth{\the\numexpr\fastinc@picdepth+1}}%
  \AddToHook{cmd/endpgfpicture/after}{\xdef\fastinc@picdepth{\the\numexpr\fastinc@picdepth-1}}}
% \tikzexternalize[<options>]{<real job>}: the real job is always \jobname
\def\fastinc@externalize[#1]{\@ifnextchar\bgroup
  {\fastinc@externalize@{#1}\@gobble}{\fastinc@externalize@{#1}}}
\def\fastinc@externalize@#1{\fastinc@orig@externalize[#1,mode=convert with system call]}
\AddToHook{file/tikzlibraryexternal.code.tex/after}{\fastinc@redirect@externalize}
\AddToHook{begindocument/before}{\InputIfFileExists{fastinc-pics.tex}{}{}}

% Deferral table (§6.3.3): empty in v1, because mylatexformat replays \openout calls (S1).
\def\fastinc@deferred{}

\endinput
