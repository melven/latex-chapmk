// Dev container for fastinc (TeX Live full + Python venv).
// Private benchmark: set FASTINC_BENCH_DOC_DIR (host directory of your real
// document) and FASTINC_BENCH_DOC_MAIN (main file name) on the host before opening.
// If you don't use a benchmark document, delete the "mounts" entry (an unset
// source path makes the container start fail).
{
  "name": "fastinc",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",
  "mounts": [
    "source=${localEnv:FASTINC_BENCH_DOC_DIR},target=/bench,type=bind,readonly"
  ],
  "containerEnv": {
    "FASTINC_BENCH_DOC": "/bench/${localEnv:FASTINC_BENCH_DOC_MAIN}"
  },
  "postCreateCommand": "if [ -f pyproject.toml ]; then pip install -e .; fi",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "james-yu.latex-workshop"
      ]
    }
  }
}
